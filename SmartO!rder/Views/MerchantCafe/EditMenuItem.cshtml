@model SmartO_rder.Models.MenuItem
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    var isNew = Model.Id == 0;
    ViewData["Title"] = isNew ? "Add dish" : "Edit dish";
    var cafes = ViewBag.Cafes as IEnumerable<SmartO_rder.Models.Cafe>;
}
<h2>@ViewData["Title"]</h2>
<form asp-action="@(isNew ? "AddMenuItem" : "EditMenuItem")" asp-route-id="@(isNew ? null : Model.Id)" method="post" style="max-width:480px">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-2"><label class="form-label">Name</label><input asp-for="Name" class="form-control" /></div>
    <div class="mb-2"><label class="form-label">Description</label><textarea asp-for="Description" class="form-control"></textarea></div>
    <div class="mb-2"><label class="form-label">Category</label><input asp-for="Category" class="form-control" /></div>
    <div class="mb-2"><label class="form-label">Price</label><input asp-for="Price" class="form-control" /></div>
    <div class="mb-2"><label class="form-label">Image URL</label><input asp-for="ImageUrl" class="form-control" /></div>
    <div class="mb-2 form-check"><input asp-for="IsAvailable" class="form-check-input" /><label asp-for="IsAvailable" class="form-check-label">Available</label></div>
    <div class="mb-2"><label class="form-label">Café</label>
        <select asp-for="CafeId" asp-items="@(new SelectList(cafes, "Id", "Name"))" class="form-select"></select></div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Menu">Cancel</a>
</form>
