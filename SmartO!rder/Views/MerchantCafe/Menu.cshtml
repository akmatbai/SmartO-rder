@model IEnumerable<SmartO_rder.Models.MenuItem>
@{ ViewData["Title"] = "Menu"; }
<h2>Menu</h2>
<p><a class="btn btn-primary" asp-action="AddMenuItem">Add dish</a> <a asp-controller="Merchant" asp-action="Dashboard">Back to dashboard</a></p>
<table class="table table-sm align-middle">
    <tr><th>Café</th><th>Category</th><th>Name</th><th>Price</th><th>Available</th><th></th></tr>
    @foreach (var m in Model)
    {
        <tr>
            <td>@m.Cafe!.Name</td><td>@m.Category</td><td>@m.Name</td><td>@m.Price.ToString("0.00")</td>
            <td>@(m.IsAvailable ? "Yes" : "No")</td>
            <td>
                <a class="btn btn-sm btn-outline-primary" asp-action="EditMenuItem" asp-route-id="@m.Id">Edit</a>
                <form method="post" asp-action="DeleteMenuItem" asp-route-id="@m.Id" class="d-inline" onsubmit="return confirm('Delete this dish?')">
                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
            </td>
        </tr>
    }
</table>
