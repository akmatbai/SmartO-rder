@model SmartO_rder.Models.Table
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Add table";
    var cafes = ViewBag.Cafes as IEnumerable<SmartO_rder.Models.Cafe>;
}
<h2>Add table</h2>
<form asp-action="AddTable" method="post" style="max-width:480px">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-2"><label class="form-label">Number</label><input asp-for="Number" class="form-control" /></div>
    <div class="mb-2"><label class="form-label">Café</label>
        <select asp-for="CafeId" asp-items="@(new SelectList(cafes, "Id", "Name"))" class="form-select"></select></div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Tables">Cancel</a>
</form>
