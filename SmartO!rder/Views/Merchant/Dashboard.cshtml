@model IEnumerable<SmartO_rder.Models.Order>
@using SmartO_rder.Models
@{
    ViewData["Title"] = "Merchant";
    var stores = (List<Store>)ViewBag.Stores;
    var cafes = (List<Cafe>)ViewBag.Cafes;
    var cafeOrders = (List<CafeOrder>)ViewBag.CafeOrders;
}
<h2>Merchant dashboard</h2>

@if (stores.Any())
{
    <h3>Stores</h3>
    <p>
        @foreach (var s in stores) { <a class="me-3" asp-controller="Store" asp-action="Index" asp-route-slug="@s.Slug">@s.Name</a> }
        | <a asp-action="Products">Products</a> | <a asp-action="AddProduct">Add product</a>
    </p>

    <h4>Store orders</h4>
    <table class="table table-sm">
        <tr><th>Date</th><th>Product</th><th>Qty</th><th>Total</th><th>Customer</th><th>Delivery</th><th>Status</th><th></th></tr>
        @foreach (var o in Model)
        {
            <tr>
                <td>@o.CreatedAt.ToLocalTime().ToString("dd.MM HH:mm")</td>
                <td>@o.Product!.Name</td>
                <td>@o.Quantity</td>
                <td>@o.Total.ToString("0.00")</td>
                <td>@o.CustomerName, @o.Phone</td>
                <td>@(o.DeliveryMethod == DeliveryMethod.Delivery ? "Delivery: " + o.Address : "Pickup")</td>
                <td>@o.Status</td>
                <td>
                    @if (o.Status == StoreOrderStatus.Paid)
                    {
                        <form method="post" asp-action="CompleteOrder" asp-route-id="@o.Id" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-success">Complete</button>
                        </form>
                    }
                    @if (o.Status == StoreOrderStatus.AwaitingPayment)
                    {
                        <form method="post" asp-action="CancelOrder" asp-route-id="@o.Id" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Cancel</button>
                        </form>
                    }
                </td>
            </tr>
        }
    </table>
}

@if (cafes.Any())
{
    <h3>Cafés</h3>
    <p>
        @foreach (var c in cafes) { <span class="me-3">@c.Name</span> }
        | <a asp-controller="MerchantCafe" asp-action="Menu">Menu</a>
        | <a asp-controller="MerchantCafe" asp-action="Tables">Tables &amp; QR codes</a>
        | <a asp-controller="MerchantCafe" asp-action="Staff">Staff</a>
    </p>

    <h4>Recent café orders</h4>
    <table class="table table-sm">
        <tr><th>Date</th><th>Café</th><th>Table</th><th>Items</th><th>Total</th><th>Status</th></tr>
        @foreach (var o in cafeOrders)
        {
            <tr>
                <td>@o.CreatedAt.ToLocalTime().ToString("dd.MM HH:mm")</td>
                <td>@o.Cafe!.Name</td>
                <td>@o.TableNumber</td>
                <td>@string.Join(", ", o.Items.Select(i => $"{i.Name} × {i.Quantity}"))</td>
                <td>@o.Total.ToString("0.00")</td>
                <td>@o.Status</td>
            </tr>
        }
    </table>
}

@if (!stores.Any() && !cafes.Any())
{
    <p>You don't own any stores or cafés yet. Ask an administrator to create one for you.</p>
}
