@model SmartO_rder.Models.PurchaseViewModel
@using SmartO_rder.Models
@{
    var p = Model.Product;
    ViewData["Title"] = p.Name;
}
<h2>Purchase @p.Name</h2>
<p>Article: @p.Article · Price: @p.Price.ToString("0.00") · In stock: @p.Quantity</p>

<form asp-action="Buy" method="post" asp-route-slug="@p.Store!.Slug" asp-route-article="@p.Article" style="max-width:480px">
    <div asp-validation-summary="All" class="text-danger"></div>
    <div class="mb-2"><label class="form-label">Quantity</label>
        <input asp-for="Form.Quantity" type="number" min="1" max="@p.Quantity" class="form-control" /></div>
    <div class="mb-2"><label class="form-label">Name</label>
        <input asp-for="Form.CustomerName" class="form-control" /></div>
    <div class="mb-2"><label class="form-label">Phone</label>
        <input asp-for="Form.Phone" class="form-control" /></div>
    <div class="mb-2">
        <label><input type="radio" asp-for="Form.DeliveryMethod" value="@DeliveryMethod.Pickup" /> Pickup</label>
        <label class="ms-3"><input type="radio" asp-for="Form.DeliveryMethod" value="@DeliveryMethod.Delivery" /> Delivery</label>
    </div>
    <div class="mb-2"><label class="form-label">Delivery address</label>
        <input asp-for="Form.Address" class="form-control" /></div>
    <button type="submit" class="btn btn-primary">Continue to payment</button>
</form>
<p class="mt-3"><a asp-action="Index" asp-route-slug="@p.Store!.Slug">Back to store</a></p>
