@model SmartO_rder.Models.Store
@{ ViewData["Title"] = Model.Name; }
<h2>@Model.Name</h2>

@if (TempData["SearchError"] is string searchError)
{
    <p class="text-danger">@searchError</p>
}
<form asp-action="Find" asp-route-slug="@Model.Slug" method="get" class="row g-2 mb-3">
    <div class="col-auto"><input type="text" name="article" class="form-control" placeholder="Article" required /></div>
    <div class="col-auto"><button type="submit" class="btn btn-primary">Find</button></div>
</form>

<table class="table align-middle">
    <tr><th></th><th>Product</th><th>Article</th><th>Price</th><th>In stock</th><th></th></tr>
    @foreach (var p in Model.Products.OrderBy(p => p.Name))
    {
        <tr>
            <td>@if (!string.IsNullOrEmpty(p.ImageUrl)) { <img src="@p.ImageUrl" alt="@p.Name" style="width:50px;height:50px;object-fit:cover;" /> }</td>
            <td>@p.Name</td>
            <td>@p.Article</td>
            <td>@p.Price.ToString("0.00")</td>
            <td>@p.Quantity</td>
            <td>
                @if (p.Quantity > 0)
                {
                    <a class="btn btn-sm btn-outline-primary" asp-action="Buy" asp-route-slug="@Model.Slug" asp-route-article="@p.Article">Buy</a>
                }
                else
                {
                    <span class="text-muted">Out of stock</span>
                }
            </td>
        </tr>
    }
</table>
