@model SmartO_rder.Models.Store
<h2>@Model.Name</h2>

@if (TempData["SearchError"] is string searchError)
{
    <p class="text-danger">@searchError</p>
}
<form asp-action="Find" asp-route-slug="@Model.Slug" method="get">
    <label>Article <input type="text" name="article" required /></label>
    <button type="submit">Find</button>
</form>

<ul>
@foreach (var p in Model.Products)
{
    <li>
        @p.Name - @p.Price
        <a asp-action="Buy" asp-route-slug="@Model.Slug" asp-route-article="@p.Article">Buy</a>
    </li>
}
</ul>
